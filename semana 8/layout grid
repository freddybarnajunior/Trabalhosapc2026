import tkinter as tk
from tkinter import messagebox

# Função para processar o envio dos dados
def enviar_dados():
    # Coleta as informações usando o dicionário 'entradas'
    nome = entradas["Nome"].get()
    email = entradas["Email"].get()
    telefone = entradas["Telefone"].get()
    
    # Validação simples: se algum campo estiver vazio, avisa o usuário
    if not nome or not email or not telefone:
        messagebox.showwarning("Aviso", "Por favor, preencha todos os campos!")
        return
        
    # Exibe uma mensagem de sucesso com os dados capturados
    resumo = f"Nome: {nome}\nEmail: {email}\nTelefone: {telefone}"
    messagebox.showinfo("Dados Enviados", resumo)
    
    # Limpa as caixas de texto após o envio bem-sucedido
    for campo in campos:
        entradas[campo].delete(0, tk.END)

# 1. Cria a janela raiz
janela = tk.Tk()
janela.title("Formulário com Grid")
janela.geometry("320x200")

campos = ["Nome", "Email", "Telefone"]
entradas = {}

# 2. Construção dinâmica da grade de entrada
for i, campo in enumerate(campos):
    # Rótulo (Label) alinhado à direita (sticky="e") na coluna 0
    tk.Label(janela, text=campo + ":", font=("Arial", 10)).grid(
        row=i, column=0, sticky="e", padx=10, pady=6)
    
    # Campo de entrada (Entry) na coluna 1
    e = tk.Entry(janela, width=24, font=("Arial", 10))
    e.grid(row=i, column=1, padx=10, pady=6, sticky="w")
    
    # Armazena a referência da Entry no dicionário usando o nome do campo como chave
    entradas[campo] = e

# 3. Configuração do Botão de Envio
# Associamos a função 'enviar_dados' ao clique e usamos columnspan para centralizar
botao_enviar = tk.Button(janela, text="Enviar Dados", command=enviar_dados, font=("Arial", 10, "bold"))
botao_enviar.grid(row=len(campos), column=0, columnspan=2, pady=15)

# 4. Inicia o loop de eventos
janela.mainloop()
