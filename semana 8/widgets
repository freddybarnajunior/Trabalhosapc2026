import tkinter as tk

# Função para processar a saudação e verificar o Checkbutton
def saudar():
    nome = entrada.get().strip()
    
    # Validação simples para evitar campos vazios
    if not nome:
        resultado.config(text="Por favor, digite um nome!", fg="red")
        return

    # Exibe a saudação padrão
    mensagem = f"Olá, {nome}!"
    
    # Verifica o estado da variável associada ao Checkbutton
    if var_lembrar.get():
        mensagem += " (Seu nome foi lembrado)"
        resultado.config(text=mensagem, fg="green")
    else:
        resultado.config(text=mensagem, fg="blue")
        entrada.delete(0, tk.END)  # Limpa o campo se não for para lembrar

# 1. Cria e configura a janela principal
janela = tk.Tk()
janela.title("Controle de Widgets")
janela.geometry("320x240")

# 2. Elementos de Entrada (Nome)
tk.Label(janela, text="Digite seu nome:", font=("Arial", 10)).pack(pady=6)
entrada = tk.Entry(janela, width=25, font=("Arial", 10))
entrada.pack(pady=2)

# 3. Variável de Controle e Checkbutton
# Alterado o nome da variável para ficar mais explícito
var_lembrar = tk.BooleanVar()
check = tk.Checkbutton(janela, text="Lembrar meu nome", variable=var_lembrar, font=("Arial", 9))
check.pack(pady=6)

# 4. Botão de Ação
botao = tk.Button(janela, text="Saudar Usuário", command=saudar, font=("Arial", 10, "bold"))
botao.pack(pady=8)

# 5. Área de Resultado
resultado = tk.Label(janela, text="", font=("Arial", 11, "bold"))
resultado.pack(pady=10)

# 6. Inicia o loop da aplicação
janela.mainloop()
