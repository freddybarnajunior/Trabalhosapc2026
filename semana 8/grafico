# ── Funções de Geração de Dados sem Linhas Fantasmas ──────────────────
def gerar_dados(tipo, freq):
    x = np.linspace(-2 * np.pi, 2 * np.pi, 1000)
    
    if tipo == "seno":
        return x, np.sin(freq * x), "steelblue"
    elif tipo == "cosseno":
        return x, np.cos(freq * x), "tomato"
    elif tipo == "quadrática":
        return x, (freq * x)**2 / 10, "darkorchid"
    elif tipo == "tangente":
        y = np.tan(freq * x)
        # Mascara os pontos de quebra/infinito para evitar as linhas verticais conectando os extremos
        limiar = 10.0
        y[y > limiar] = np.nan
        y[y < -limiar] = np.nan
        return x, y, "seagreen"

