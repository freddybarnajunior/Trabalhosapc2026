import pandas as pd

def carregar_dados():
    """Lê e limpa os arquivos PDAD; retorna dois DataFrames."""
    # Ajuste os nomes dos arquivos conforme necessário
    df_moradores = pd.read_csv('moradores.csv', sep=';')
    df_domicilios = pd.read_csv('domicilios.xlsx - Planilha1.csv', sep=',')
    
    # Exemplo de limpeza: remover valores sentinela (99999) 
    # se for analisar colunas numéricas específicas do bloco F
    return df_moradores, df_domicilios
def calcular_distribuicao_bloco_f(df, coluna_f):
    """Retorna contagem por categoria para colunas do bloco F."""
    # Filtra apenas valores válidos (excluindo 99999)
    df_valido = df[df[coluna_f] != 99999]
    return df_valido[coluna_f].value_counts().sort_index()
